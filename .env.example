# Custodian AI — Environment Configuration Template
# Copy this file to .env and adjust values if needed.
# .env is git-ignored and contains local secrets.

# Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Security & Authentication (Demo / Dev secret only)
JWT_SECRET=dev-insecure-custodian-ai-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Demo Credentials (Seeded for local evaluation)
DEMO_STUDENT1_USERNAME=student1
DEMO_STUDENT1_PASSWORD=student1pass
DEMO_STUDENT2_USERNAME=student2
DEMO_STUDENT2_PASSWORD=student2pass
DEMO_FACULTY1_USERNAME=faculty1
DEMO_FACULTY1_PASSWORD=faculty1pass

# Database (SQLite for Phase A; PostgreSQL for Phase B)
DATABASE_URL=sqlite:///./custodian.db

# Service Ports (Phase A uvicorn services)
CAPTURE_DETECT_PORT=8001
RISK_ENGINE_PORT=8002
INVESTIGATOR_PORT=8003
WARN_ESCALATE_PORT=8004
REVIEW_REPORT_PORT=8005

# Risk Engine Parameters (Section 5 of AGENTS.md)
RISK_HALF_LIFE_SECONDS=240
CHANNEL_ACCUMULATOR_CAP=40
CORROBORATION_LAMBDA=0.20
TIER_HYSTERESIS_SECONDS=6
MASS_FLAG_WINDOW_SECONDS=60
MASS_FLAG_SESSION_RATIO=0.30


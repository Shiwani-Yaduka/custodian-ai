# ==============================================================================
# Custodian AI — Comprehensive .gitignore
# ==============================================================================

# --- Private Notes, Prompts, Guides & Agent Study Material ---
.agent-notes/
.agent-notes/**
AGENTS.md
*GUIDE.md
DEVOPS_GUIDE.md
PROMPTS*.md
*PROMPT*.md
*.notes.md
fairness.txt

# --- Environment & Secret Configuration ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
pip-wheel-metadata/

# --- Python Bytecode & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing, Coverage & Linters ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
coverage.json

# --- Node.js, Frontend & Build Distribution ---
node_modules/
web/node_modules/
web/dist/
web/public/wasm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
web/.env.local
web/.env.*.local

# --- Databases & SQLite Transient Files ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
custodian.db
test.db

# --- Process PIDs & Runtime Logs ---
.services.pids
*.pid
*.log

# --- IDEs & Operating System Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
